# Match hardware IDs so autosuspend protection follows the hubs and mouse
# when they move ports. Support both the Basilisk V3 and Basilisk V3 35K.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="05e3", ATTR{idProduct}=="0610", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="1532", ATTR{idProduct}=="0099|00cb", TEST=="power/control", ATTR{power/control}="on"
