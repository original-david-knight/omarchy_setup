# Ghostty Configuration
# CaskaydiaMono Nerd Font; colors follow the active Omarchy theme

# Font Configuration
font-family = CaskaydiaMono Nerd Font
font-size = 32

# Window Configuration
gtk-titlebar = false
window-padding-x = 14
window-padding-y = 0

# Colors come from the active Omarchy theme, regenerated by `omarchy theme set`.
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# Slowdown mouse scrolling
mouse-scroll-multiplier = 1.4
# Keep selection and middle-click paste working inside mouse-aware TUIs.
mouse-reporting = false
# Disable terminal focus reporting to prevent focus-locking with Claude Code
# shell-integration-features = no-focus-reporting

window-inherit-working-directory = false

# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u

# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u
