#!/usr/bin/env bash
set -euo pipefail

if (( $# < 1 || $# > 3 )) || [[ -z ${1//[[:space:]]/} ]]; then
  echo "A task ID is required" >&2
  exit 2
fi

done_state="${2:-true}"
if [[ $done_state != true && $done_state != false ]]; then
  echo "Task state must be true or false" >&2
  exit 2
fi
revision="${3:-}"
if (( $# == 3 )) && [[ ! $revision =~ ^[1-9][0-9]*$ ]]; then
  echo "A positive task revision is required" >&2
  exit 2
fi

config="${EVERYTHING_AGENT_CONFIG_DIR:-$HOME/.config/everything-agent}/config.json"
service_url="$(jq -er '.service_url | rtrimstr("/")' "$config")"
token="$(jq -er .token "$config")"
task_id="$(jq -rn --arg id "$1" '$id | @uri')"

# Send the intended state explicitly, so a retry never toggles the task back.
# The bar supplies the revision it displayed to protect concurrent edits.
headers=()
if [[ -n $revision ]]; then
  headers+=(-H "X-Base-Revision: $revision")
fi
payload="$(jq -cn --argjson done "$done_state" '{done:$done}')"
response="$(
  curl -sS --max-time 20 \
    -X PATCH \
    -H "Authorization: Bearer $token" \
    -H "Content-Type: application/json" \
    "${headers[@]}" \
    --data-binary "$payload" \
    --write-out $'\n%{http_code}' \
    "$service_url/api/tasks/$task_id"
)"
body="${response%$'\n'*}"
status="${response##*$'\n'}"

if [[ $status == 2* ]]; then
  if jq -e --arg id "$1" --argjson done "$done_state" '.id == $id and .done == $done' <<<"$body" >/dev/null 2>&1; then
    exit 0
  fi
  echo "Everything App did not confirm the requested task state" >&2
elif [[ $status == 409 ]]; then
  echo "Task changed; refresh and try again (HTTP 409)" >&2
else
  echo "Task could not be updated (HTTP $status)" >&2
fi
exit 1
