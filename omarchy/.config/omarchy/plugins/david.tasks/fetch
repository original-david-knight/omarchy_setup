#!/usr/bin/env bash
set -euo pipefail

config="${EVERYTHING_AGENT_CONFIG_DIR:-$HOME/.config/everything-agent}/config.json"
service_url="$(jq -er '.service_url | rtrimstr("/")' "$config")"
token="$(jq -er .token "$config")"

curl -fsS --max-time 20 \
  -H "Authorization: Bearer $token" \
  "$service_url/api/tasks" \
| jq -c '
    (.tasks // []) as $tasks
    | ([$tasks[] | select(.done != true)] | length) as $open
    | {
        open: (.open // $open),
        meta: (.meta // (($open | tostring) + " open")),
        tasks: [$tasks[] | {
          id: (.id // ""),
          title: (.title // ""),
          source: (.source // ""),
          done: (.done // false),
          view: (.view // (if .done then "completed" else "action" end)),
          can_complete: (.can_complete == true),
          next_action: (.next_action // ""),
          project_name: (.project_name // .project_key // ""),
          item_key: (.item_key // .id // ""),
          status: (.status // ""),
          assignee: (.assignee // ""),
          revision: (.revision // 0)
        }]
      }
  '
