#!/usr/bin/env python3
"""Shared assignment transport for the Tasks, Jira and PR bar panels."""
import json
import os
from pathlib import Path
import sys
import urllib.error
import urllib.parse
import urllib.request


class Failure(Exception):
    pass


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *_):
        return None


def context(value):
    return (isinstance(value, dict)
            and all(isinstance(value.get(key), str) for key in
                    ("id", "title", "project_id", "assignee", "status"))
            and type(value.get("revision")) is int and value["revision"] >= 0)


def run(args):
    if (len(args) not in (3, 6) or args[0] not in ("preview", "assign")
            or len(args) != (3 if args[0] == "preview" else 6)
            or args[1] not in ("task", "jira", "github")
            or any(not arg.strip() for arg in args[2:])
            or (args[0] == "assign" and not args[5].isascii())
            or (args[0] == "assign" and not args[5].isdigit())):
        print("Usage: delegate preview SOURCE KEY | delegate assign SOURCE KEY PROJECT AGENT REVISION", file=sys.stderr)
        return 2
    mode, source, key = args[:3]
    try:
        folder = Path(os.environ.get("EVERYTHING_AGENT_CONFIG_DIR", Path.home() / ".config/everything-agent"))
        config = json.loads((folder / "config.json").read_text())
        base = config["service_url"].rstrip("/")
        token = config["token"]
        url = urllib.parse.urlsplit(base)
        if url.scheme not in ("http", "https") or not url.netloc or url.username or not isinstance(token, str) or not token:
            raise ValueError()
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        raise Failure("Everything App configuration could not be read") from None
    opener = urllib.request.build_opener(NoRedirect())

    def request(path, body=None):
        payload = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(base + path, data=payload, headers={
            "Authorization": "Bearer " + token, "Content-Type": "application/json"})
        try:
            with opener.open(req, timeout=20) as response:
                if response.status != 200:
                    raise Failure("Everything App did not confirm the request")
                return json.load(response)
        except urllib.error.HTTPError as error:
            if error.code == 409:
                raise Failure("Task changed or is already being worked on. Reload options before assigning again.") from None
            raise Failure(f"Assignment request failed (HTTP {error.code}); open Everything App for details") from None
        except (OSError, ValueError):
            raise Failure("Everything App could not be reached or returned an invalid response") from None

    if mode == "preview":
        task = request("/api/delegation?" + urllib.parse.urlencode({"source": source, "key": key}))
        options = request("/api/projects")
        if (not context(task) or not isinstance(options, dict)
                or not isinstance(options.get("projects"), list) or not isinstance(options.get("agents"), list)):
            raise Failure("Assignment options could not be read")
        # Pass only display and selection data to QML. Credentials stay here.
        projects = [{"value": p["id"], "label": p["key"] + " · " + p["name"]}
                    for p in options["projects"] if isinstance(p, dict)
                    and all(isinstance(p.get(k), str) for k in ("id", "key", "name", "repo_path"))
                    and p["id"] and p["repo_path"].strip() and p.get("status") == "active"]
        agents = [{"value": a["name"], "label": a["name"]}
                  for a in options["agents"] if isinstance(a, dict)
                  and isinstance(a.get("name"), str) and a["name"]
                  and a.get("enabled") is True and a.get("availability") != "unavailable"]
        print(json.dumps({"task": task, "projects": projects, "agents": agents}))
    else:
        project, agent, revision = args[3], args[4], int(args[5])
        result = request("/api/delegation", {"source": source, "key": key,
                         "project_id": project, "assignee": agent, "revision": revision})
        if (not context(result) or not result["id"] or not result["status"]
                or result["project_id"] != project or result["assignee"] != agent
                or result["revision"] < max(1, revision)):
            raise Failure("Everything App did not confirm the assignment. Reload options before trying again.")
        print(json.dumps(result))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(run(sys.argv[1:]))
    except Failure as error:
        print(error, file=sys.stderr)
        sys.exit(1)
