#!/usr/bin/env bash
set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/david-podcasts"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/david-podcasts"
socket="$runtime_dir/mpv.sock"
pid_file="$runtime_dir/mpv.pid"
state_file="$state_dir/player.json"

mkdir -p "$runtime_dir" "$state_dir"
chmod 700 "$runtime_dir" "$state_dir"

send() {
  local payload="$1"
  printf '%s\n' "$payload" | socat -T 0.25 - "UNIX-CONNECT:$socket"
}

available() {
  [[ -S $socket ]] && send '{"command":["get_property","idle-active"]}' >/dev/null 2>&1
}

ensure_player() {
  if available; then
    return
  fi

  local -a mpris_args=()
  if [[ -r /usr/lib/mpv-mpris/mpris.so ]]; then
    mpris_args+=(--script=/usr/lib/mpv-mpris/mpris.so)
  fi

  if [[ -r $pid_file ]]; then
    old_pid="$(<"$pid_file")"
    if [[ $old_pid =~ ^[0-9]+$ ]] && kill -0 "$old_pid" 2>/dev/null; then
      for _ in {1..20}; do
        [[ -S $socket ]] && return
        sleep 0.05
      done
    fi
  fi

  rm -f "$socket"
  mpv \
    --no-config \
    --no-video \
    --audio-display=no \
    --idle=yes \
    --terminal=no \
    --force-window=no \
    --input-media-keys=no \
    --resume-playback=no \
    "${mpris_args[@]}" \
    --input-ipc-server="$socket" \
    >/dev/null 2>&1 </dev/null &
  printf '%s\n' "$!" >"$pid_file"

  for _ in {1..40}; do
    [[ -S $socket ]] && return
    sleep 0.05
  done

  printf 'Podcast player did not start\n' >&2
  exit 1
}

service_url=""
token=""

load_service_config() {
  local config="${EVERYTHING_AGENT_CONFIG_DIR:-$HOME/.config/everything-agent}/config.json"
  service_url="$(jq -er '.service_url | rtrimstr("/")' "$config")"
  token="$(jq -er .token "$config")"
}

save_remote_progress() {
  local episode_id="$1" position="$2" duration="$3" completed="$4"
  local encoded_id body

  load_service_config
  encoded_id="$(jq -rn --arg value "$episode_id" '$value | @uri')"
  body="$(jq -cn \
    --argjson position "$position" \
    --argjson duration "$duration" \
    --argjson completed "$completed" \
    --arg played_at "$(date --iso-8601=seconds)" \
    '{position_seconds:($position|round),duration_seconds:($duration|round),completed:$completed,played_at:$played_at}')"
  curl -fsS --max-time 20 \
    --request PUT \
    -H "Authorization: Bearer $token" \
    -H 'Content-Type: application/json' \
    --data "$body" \
    "$service_url/api/podcasts/progress/$encoded_id" >/dev/null
}

save_loaded_episode() {
  local next_episode_id="$1" current_episode_id position duration

  [[ -r $state_file ]] || return 0
  current_episode_id="$(jq -er '.episode_id // empty' "$state_file")" || return 0
  [[ -n $current_episode_id && $current_episode_id != "$next_episode_id" ]] || return 0
  available || return 0

  position="$(send '{"command":["get_property","time-pos"]}' \
    | jq -er 'select(.error == "success") | .data')" || return 0
  duration="$(send '{"command":["get_property","duration"]}' \
    | jq -er 'select(.error == "success") | .data')" || duration=0
  [[ $position =~ ^[0-9]+([.][0-9]+)?$ ]] || return 0
  [[ $duration =~ ^[0-9]+([.][0-9]+)?$ ]] || duration=0

  save_remote_progress "$current_episode_id" "$position" "$duration" false
}

remote_position() {
  local episode_id="$1" queue

  load_service_config
  queue="$(curl -fsS --max-time 20 \
    -H "Authorization: Bearer $token" \
    "$service_url/api/podcasts/queue")"
  jq -er --arg episode_id "$episode_id" '
    .entries[]
    | select(.episode_id == $episode_id)
    | (.position_seconds // 0) as $position
    | (.duration_seconds // 0) as $duration
    | if (.completed // false) and $duration > 0 and $position >= $duration - 1
      then 0
      else $position
      end
  ' <<<"$queue"
}

command="${1:-status}"

case "$command" in
  load|switch)
    episode_id="${2:-}"
    url="${3:-}"
    position="${4:-0}"
    duration="${5:-0}"
    title="${6:-Untitled episode}"
    show_title="${7:-Podcast}"

    [[ -n $episode_id && ( $url == http://* || $url == https://* ) ]] || {
      printf 'A playable podcast episode is required\n' >&2
      exit 2
    }
    [[ $position =~ ^[0-9]+([.][0-9]+)?$ ]] || position=0
    [[ $duration =~ ^[0-9]+([.][0-9]+)?$ ]] || duration=0

    ensure_player
    if [[ $command == switch ]]; then
      save_loaded_episode "$episode_id"
    fi
    if latest_position="$(remote_position "$episode_id")"; then
      position="$latest_position"
    fi
    jq -cn --arg url "$url" --arg start "$position" \
      '{command:["loadfile",$url,"replace",-1,{start:$start}]}' | send "$(cat)" >/dev/null

    tmp_state="$state_file.tmp.$$"
    jq -cn \
      --arg episode_id "$episode_id" \
      --arg title "$title" \
      --arg show_title "$show_title" \
      --arg source_url "$url" \
      --argjson start_position "$position" \
      --argjson duration "$duration" \
      '{episode_id:$episode_id,title:$title,show_title:$show_title,source_url:$source_url,start_position:$start_position,duration:$duration}' \
      >"$tmp_state"
    chmod 600 "$tmp_state"
    mv -f "$tmp_state" "$state_file"
    ;;
  toggle)
    ensure_player
    send '{"command":["cycle","pause"]}' >/dev/null
    ;;
  play)
    ensure_player
    send '{"command":["set_property","pause",false]}' >/dev/null
    ;;
  pause)
    ensure_player
    send '{"command":["set_property","pause",true]}' >/dev/null
    ;;
  seek)
    amount="${2:-0}"
    [[ $amount =~ ^-?[0-9]+([.][0-9]+)?$ ]] || exit 2
    ensure_player
    send "$(jq -cn --argjson amount "$amount" '{command:["seek",$amount,"relative"]}')" >/dev/null
    ;;
  seek-to)
    position="${2:-0}"
    [[ $position =~ ^[0-9]+([.][0-9]+)?$ ]] || exit 2
    ensure_player
    send "$(jq -cn --argjson position "$position" '{command:["seek",$position,"absolute+exact"]}')" >/dev/null
    ;;
  speed)
    speed="${2:-1}"
    [[ $speed =~ ^[0-9]+([.][0-9]+)?$ ]] || exit 2
    ensure_player
    send "$(jq -cn --argjson speed "$speed" '{command:["set_property","speed",$speed]}')" >/dev/null
    ;;
  stop)
    ensure_player
    send '{"command":["stop"]}' >/dev/null
    ;;
  save)
    episode_id="${2:-}"
    position="${3:-0}"
    duration="${4:-0}"
    completed="${5:-false}"
    [[ $episode_id ]] || exit 2
    [[ $position =~ ^[0-9]+([.][0-9]+)?$ ]] || position=0
    [[ $duration =~ ^[0-9]+([.][0-9]+)?$ ]] || duration=0
    [[ $completed == true ]] || completed=false

    save_remote_progress "$episode_id" "$position" "$duration" "$completed"
    ;;
  status)
    if ! available; then
      jq -cn --slurpfile state <(if [[ -r $state_file ]]; then cat "$state_file"; else printf '{}\n'; fi) \
        '{available:false,idle:true,paused:true,position:0,duration:0,speed:1} + ($state[0] // {})'
      exit
    fi

    responses="$(printf '%s\n' \
      '{"command":["get_property","time-pos"],"request_id":1}' \
      '{"command":["get_property","duration"],"request_id":2}' \
      '{"command":["get_property","pause"],"request_id":3}' \
      '{"command":["get_property","idle-active"],"request_id":4}' \
      '{"command":["get_property","speed"],"request_id":5}' \
      '{"command":["get_property","path"],"request_id":6}' \
      | socat -T 0.25 - "UNIX-CONNECT:$socket" || true)"
    jq -cs --slurpfile state <(if [[ -r $state_file ]]; then cat "$state_file"; else printf '{}\n'; fi) '
      reduce .[] as $response
        ({available:true,idle:true,paused:true,position:0,duration:0,speed:1,path:""};
          if $response.request_id == 1 then .position = ($response.data // 0)
          elif $response.request_id == 2 then .duration = ($response.data // 0)
          elif $response.request_id == 3 then
            .paused = (if $response.error == "success" then ($response.data == true) else true end)
          elif $response.request_id == 4 then
            .idle = (if $response.error == "success" then ($response.data == true) else true end)
          elif $response.request_id == 5 then .speed = ($response.data // 1)
          elif $response.request_id == 6 then .path = ($response.data // "")
          else . end)
      + (($state[0] // {}) | del(.duration))
      | .duration = if .duration > 0 then .duration else ($state[0].duration // 0) end
    ' <<<"$responses"
    ;;
  *)
    printf 'usage: player <load|switch|toggle|play|pause|seek|seek-to|speed|stop|save|status> ...\n' >&2
    exit 2
    ;;
esac
