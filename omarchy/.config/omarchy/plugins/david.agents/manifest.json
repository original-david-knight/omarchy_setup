{
  "schemaVersion": 1,
  "id": "david.agents",
  "name": "Agents with accounts",
  "version": "1.0.0",
  "author": "David Knight",
  "license": "MIT",
  "description": "The stock Omarchy Agents panel with Claude account switching, remaining allowances, and live Antigravity quota.",
  "kinds": ["bar-widget"],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Agents",
    "description": "Agent usage, limits, and pace, with Claude account switching, quota previews, and live Antigravity quota.",
    "category": "AI",
    "aliases": ["agents", "model-usage", "claude-account"],
    "allowMultiple": false,
    "defaults": {
      "providers": {
        "claude": { "enabled": true },
        "codex": { "enabled": true },
        "agy": { "enabled": true },
        "fireworks": { "enabled": true }
      },
      "refreshIntervalSec": 900,
      "syncMode": "Off",
      "syncDir": "",
      "syncFileName": "",
      "syncDeviceId": ""
    }
  },
  "omarchy": {
    "extends": "omarchy.agents"
  }
}
