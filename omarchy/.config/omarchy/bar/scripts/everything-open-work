#!/usr/bin/env bash

set -uo pipefail

url=${1:-}
local_state=${EVERYTHING_CHROME_LOCAL_STATE:-"${HOME}/.config/google-chrome/Local State"}
profile_dir=${EVERYTHING_WORK_CHROME_PROFILE:-}

notify_failure() {
  command -v notify-send >/dev/null 2>&1 && notify-send "Everything" "$1"
  printf '%s\n' "$1" >&2
  exit 1
}

env_value() {
  local key=$1 file=$2
  [[ -r $file ]] || return 0
  sed -n "s/^${key}=//p" "$file" | tail -n 1
}

resolve_profile() {
  [[ -r $local_state ]] || return 0

  local work_email
  work_email=$(env_value JIRA_EMAIL "${HOME}/.config/lifedash/jira.env")
  if [[ -z $work_email ]]; then
    work_email=$(env_value GITHUB_EMAIL "${HOME}/.config/lifedash/github.env")
  fi

  if [[ -n $work_email ]]; then
    profile_dir=$(jq -r --arg email "$work_email" '
      .profile.info_cache
      | to_entries
      | map(select(((.value.user_name // "") | ascii_downcase) == ($email | ascii_downcase)))
      | .[0].key // empty
    ' "$local_state" 2>/dev/null)
  fi

  # The profile name is a useful fallback if an account stops publishing its
  # email to Chrome's registry. It never falls back to Default: work links
  # should fail visibly rather than silently open under the personal account.
  if [[ -z $profile_dir ]]; then
    profile_dir=$(jq -r '
      .profile.info_cache
      | to_entries
      | map(select(((.value.name // "") | ascii_downcase) == "fluxon"))
      | .[0].key // empty
    ' "$local_state" 2>/dev/null)
  fi
}

command -v jq >/dev/null 2>&1 || notify_failure "jq is required to find the work Chrome profile."

if [[ -z $profile_dir ]]; then
  resolve_profile
fi
[[ -n $profile_dir ]] || notify_failure "The work Chrome profile could not be found."

if [[ $url == --print-profile ]]; then
  printf '%s\n' "$profile_dir"
  exit 0
fi

[[ $url == https://* ]] || notify_failure "Refusing to open a non-HTTPS work link."
[[ -x /usr/bin/google-chrome-stable ]] || notify_failure "Google Chrome is not installed."

nohup /usr/bin/google-chrome-stable \
  --profile-directory="$profile_dir" \
  --new-tab \
  "$url" >/dev/null 2>&1 &
