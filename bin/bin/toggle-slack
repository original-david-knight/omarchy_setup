#!/bin/bash
# Toggle Slack in special:slack workspace

workspace="special:slack"
workspace_name="slack"
slack_class='^[sS]lack$'

find_window() {
    local class_regex=$1

    hyprctl clients -j | jq -r --arg class_regex "$class_regex" '
        .[]
        | select(
            ((.class // "") | test($class_regex)) or
            ((.initialClass // "") | test($class_regex))
        )
        | .address
    ' | head -n 1
}

window_in_workspace() {
    local class_regex=$1

    hyprctl clients -j | jq -e --arg class_regex "$class_regex" --arg workspace "$workspace" '
        .[]
        | select(
            (
                ((.class // "") | test($class_regex)) or
                ((.initialClass // "") | test($class_regex))
            ) and (.workspace.name == $workspace)
        )
    ' > /dev/null 2>&1
}

special_workspace_visible() {
    hyprctl monitors -j | jq -e --arg workspace "$workspace" '
        .[] | select(.specialWorkspace.name == $workspace)
    ' > /dev/null 2>&1
}

toggle_special_workspace() {
    hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$workspace_name\")"
}

show_special_workspace() {
    special_workspace_visible || toggle_special_workspace
}

move_window_to_special() {
    local class_regex=$1
    local addr

    addr=$(find_window "$class_regex")
    [[ -n "$addr" ]] || return 1

    hyprctl dispatch "hl.dsp.window.move({ workspace = \"$workspace\", follow = false, window = \"address:$addr\" })" > /dev/null
}

# Hiding takes precedence over app detection. This keeps the toggle responsive
# even when Slack is still starting or has closed.
if special_workspace_visible; then
    toggle_special_workspace
    exit 0
fi

if window_in_workspace "$slack_class"; then
    toggle_special_workspace
    exit 0
fi

if ! move_window_to_special "$slack_class"; then
    uwsm-app -- slack &
fi

for _ in $(seq 1 20); do
    if window_in_workspace "$slack_class" || move_window_to_special "$slack_class"; then
        show_special_workspace
        exit 0
    fi

    sleep 0.5
done

show_special_workspace
