#!/usr/bin/env bash

set -euo pipefail

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
branding_dir="$config_home/omarchy/branding"
art_txt="${OMARCHY_PLYMOUTH_ART:-$branding_dir/screensaver.txt}"
logo_png="${OMARCHY_PLYMOUTH_LOGO:-$branding_dir/death-star-plymouth.png}"

background="${OMARCHY_PLYMOUTH_BACKGROUND:-#1a1b26}"
foreground="${OMARCHY_PLYMOUTH_FOREGROUND:-#c0caf5}"
font_spec="${OMARCHY_PLYMOUTH_ASCII_FONT:-JetBrainsMono Nerd Font}"
point_size="${OMARCHY_PLYMOUTH_ASCII_POINT_SIZE:-11}"
canvas_width="${OMARCHY_PLYMOUTH_CANVAS_WIDTH:-640}"
canvas_height="${OMARCHY_PLYMOUTH_CANVAS_HEIGHT:-560}"

if [[ ! -f $art_txt ]]; then
  echo "Missing Plymouth ASCII art: $art_txt" >&2
  exit 1
fi

for command_name in fc-match magick omarchy; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "Missing required command: $command_name" >&2
    exit 1
  fi
done

if ! sudo -n true 2>/dev/null; then
  echo "Plymouth installation requires passwordless sudo." >&2
  exit 1
fi

if [[ -f $font_spec ]]; then
  font_path=$font_spec
else
  font_path=$(fc-match -f '%{file}\n' "$font_spec")
fi

if [[ ! -f $font_path ]]; then
  echo "Unable to resolve Plymouth ASCII font: $font_spec" >&2
  exit 1
fi

tmp_logo=$(mktemp --suffix=.png)
trap 'rm -f "$tmp_logo"' EXIT

magick \
  -background none \
  -fill "$foreground" \
  -font "$font_path" \
  -pointsize "$point_size" \
  -interline-spacing -1 \
  "label:@$art_txt" \
  -trim +repage \
  -gravity center \
  -extent "${canvas_width}x${canvas_height}" \
  "$tmp_logo"

install -m 0644 "$tmp_logo" "$logo_png"

# Older theme customizations could leave these package directories user-owned.
# Restore the package's directory metadata before Omarchy validates its publish
# destinations. Only the two directories are changed; their contents stay put.
for theme_dir in /usr/share/plymouth/themes/omarchy /usr/share/sddm/themes/omarchy; do
  if [[ ! -d $theme_dir || -L $theme_dir || $(realpath -e -- "$theme_dir") != "$theme_dir" ]]; then
    echo "Expected a real theme directory at $theme_dir; repair the Omarchy theme package before retrying." >&2
    exit 1
  fi
  parent_dir=$(dirname -- "$theme_dir")
  while :; do
    parent_mode=$(stat -c %a -- "$parent_dir")
    if [[ $(stat -c %u -- "$parent_dir") != 0 ]] || (( (8#$parent_mode & 0022) != 0 )); then
      echo "Cannot prepare $theme_dir: parent $parent_dir must be root-owned and not group- or world-writable." >&2
      exit 1
    fi
    [[ $parent_dir != / ]] || break
    parent_dir=$(dirname -- "$parent_dir")
  done
  if [[ $(stat -c '%u:%g:%a' -- "$theme_dir") != 0:0:755 ]]; then
    echo "Restoring root ownership and mode 0755 on $theme_dir"
    sudo /usr/bin/install -d -o root -g root -m 0755 -- "$theme_dir"
  fi
done

omarchy plymouth set "$background" "$foreground" "$logo_png"
