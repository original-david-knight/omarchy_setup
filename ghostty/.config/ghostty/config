# Ghostty Configuration
# CaskaydiaMono Nerd Font; colors follow the active Omarchy theme

# Font Configuration
font-family = CaskaydiaMono Nerd Font
font-size = 18

# Window Configuration
window-padding-x = 14
window-padding-y = 0

# Colors come from the active Omarchy theme, regenerated by `omarchy theme set`.
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# Disable terminal focus reporting to prevent focus-locking with Claude Code
#shell-integration-features = no-focus-reporting
window-inherit-working-directory = false
