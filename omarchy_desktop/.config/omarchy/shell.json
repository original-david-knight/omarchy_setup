{
  "bar": {
    "centerAnchor": "omarchy.spacer",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "exec": "date '+%A %b %-d'",
          "id": "webcam-date",
          "interval": 60,
          "tooltip": "Full date",
          "type": "command"
        },
        {
          "id": "omarchy.spacer",
          "size": 440
        },
        {
          "id": "omarchy.clock",
          "format": "HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm",
          "birthYear": 1966,
          "lifeExpectancy": 90
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "david.tray",
          "pinned": [
            "Slack_status_icon_1"
          ]
        },
        {
          "id": "omarchy.spacer",
          "size": 24
        },
        {
          "id": "david.github-work"
        },
        {
          "id": "david.jira-work"
        },
        {
          "id": "david.podcasts"
        },
        {
          "id": "david.tasks"
        },
        {
          "id": "omarchy.spacer",
          "size": 320
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.dropbox"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 600,
    "screensaver": 600
  },
  "plugins": [],
  "version": 1
}
