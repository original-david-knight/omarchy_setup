{
  "bar": {
    "centerAnchor": "omarchy.spacer",
    "id": "david.bar",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "exec": "date '+%A %b %-d'",
          "id": "webcam-date",
          "interval": 60,
          "tooltip": "Full date",
          "type": "command"
        },
        {
          "id": "omarchy.spacer",
          "size": 440
        },
        {
          "id": "omarchy.clock",
          "format": "HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm",
          "birthYear": 1966,
          "lifeExpectancy": 90
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.spacer",
          "size": 24
        },
        {
          "id": "david.podcasts"
        },
        {
          "id": "david.headset"
        },
        {
          "id": "omarchy.audio"
        }
      ],
      "right": [
        {
          "id": "david.tray",
          "pinned": [
            "Slack_status_icon_1"
          ]
        },
        {
          "id": "omarchy.spacer",
          "size": 24
        },
        {
          "id": "david.github-work"
        },
        {
          "id": "david.jira-work"
        },
        {
          "id": "david.tasks"
        },
        {
          "id": "omarchy.spacer",
          "size": 320
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "screenLayouts": [
      {
        "name": "portrait side monitors",
        "match": "portrait",
        "layout": {
          "left": [
            {
              "id": "omarchy.workspaces"
            }
          ],
          "center": [
            {
              "id": "omarchy.clock",
              "format": "HH:mm",
              "formatAlt": "d MMMM 'W'ww yyyy",
              "verticalFormat": "HH\n—\nmm",
              "birthYear": 1966,
              "lifeExpectancy": 90
            }
          ],
          "right": []
        }
      }
    ],
    "transparent": false
  },
  "idle": {
    "lock": 600,
    "screensaver": 600
  },
  "plugins": [
    {
      "id": "david.media"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.media"
  ],
  "cloneSourceRestores": [
    "david.media"
  ]
}
