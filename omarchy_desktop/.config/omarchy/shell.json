{
  "bar": {
    "centerAnchor": "omarchy.spacer",
    "id": "david.bar",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "exec": "date '+%A %b %-d'",
          "id": "webcam-date",
          "interval": 60,
          "tooltip": "Full date",
          "type": "command"
        },
        {
          "id": "omarchy.spacer",
          "size": 440
        },
        {
          "id": "omarchy.clock",
          "format": "HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm",
          "birthYear": 1966,
          "lifeExpectancy": 90
        },
        {
          "id": "omarchy.elsewhen",
          "cities": [
            {
              "name": "Los Angeles",
              "zone": "America/Los_Angeles"
            },
            {
              "name": "New York",
              "zone": "America/New_York"
            },
            {
              "name": "London",
              "zone": "Europe/London"
            },
            {
              "name": "Dubai",
              "zone": "Asia/Dubai"
            },
            {
              "name": "Tokyo",
              "zone": "Asia/Tokyo"
            }
          ]
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "david.workspaces"
        },
        {
          "id": "omarchy.spacer",
          "size": 24
        },
        {
          "id": "david.podcasts"
        },
        {
          "id": "david.bach"
        },
        {
          "id": "david.headset"
        },
        {
          "id": "omarchy.audio"
        }
      ],
      "right": [
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "david.tray",
          "pinned": [
            "Slack_status_icon_1"
          ]
        },
        {
          "id": "jankeesvw.meeting-recorder"
        },
        {
          "id": "david.meeting",
          "litra": true
        },
        {
          "id": "omarchy.spacer",
          "size": 24
        },
        {
          "id": "david.github-work"
        },
        {
          "id": "david.jira-work"
        },
        {
          "id": "david.tasks"
        },
        {
          "id": "omarchy.spacer",
          "size": 320
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "david.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "david.security"
        }
      ],
      "centerBegin": [],
      "centerEnd": [],
      "tray": []
    },
    "position": "top",
    "screenLayouts": [
      {
        "name": "portrait side monitors",
        "match": "portrait",
        "layout": {
          "left": [
            {
              "id": "david.workspaces"
            }
          ],
          "center": [
            {
              "id": "omarchy.clock",
              "format": "HH:mm",
              "formatAlt": "d MMMM 'W'ww yyyy",
              "verticalFormat": "HH\n—\nmm",
              "birthYear": 1966,
              "lifeExpectancy": 90
            }
          ],
          "right": []
        }
      }
    ],
    "transparent": false
  },
  "idle": {
    "lock": 600,
    "screensaver": 600
  },
  "plugins": [
    {
      "id": "david.media"
    },
    {
      "id": "david.backgrounds"
    },
    {
      "id": "io.github.itsgg.nodi"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.media"
  ],
  "cloneSourceRestores": [
    "david.media"
  ]
}
